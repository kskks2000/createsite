# Auto-detect text files and normalize line endings to LF on commit
* text=auto eol=lf

# Explicitly declare text files
*.js        text eol=lf
*.jsx       text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.mjs       text eol=lf
*.cjs       text eol=lf
*.json      text eol=lf
*.jsonc     text eol=lf
*.css       text eol=lf
*.scss      text eol=lf
*.html      text eol=lf
*.htm       text eol=lf
*.xml       text eol=lf
*.svg       text eol=lf
*.md        text eol=lf
*.mdx       text eol=lf
*.txt       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.toml      text eol=lf
*.env       text eol=lf
*.sh        text eol=lf
*.bash      text eol=lf
*.py        text eol=lf
*.rb        text eol=lf
*.go        text eol=lf
*.rs        text eol=lf
*.java      text eol=lf
*.kt        text eol=lf
*.swift     text eol=lf
*.c         text eol=lf
*.cpp       text eol=lf
*.h         text eol=lf
*.sql       text eol=lf
*.graphql   text eol=lf
*.prisma    text eol=lf
*.proto     text eol=lf
Makefile    text eol=lf
Dockerfile  text eol=lf
.gitignore  text eol=lf
.gitattributes text eol=lf

# Windows scripts — keep CRLF
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# Binary files — no line ending conversion
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.webp      binary
*.avif      binary
*.tiff      binary
*.bmp       binary
*.svg       binary diff=svg
*.pdf       binary
*.zip       binary
*.tar       binary
*.gz        binary
*.tgz       binary
*.rar       binary
*.7z        binary
*.exe       binary
*.dll       binary
*.so        binary
*.dylib     binary
*.wasm      binary
*.ttf       binary
*.otf       binary
*.woff      binary
*.woff2     binary
*.eot       binary
*.mp3       binary
*.mp4       binary
*.webm      binary
*.ogg       binary
*.wav       binary

# Diff drivers
*.json      diff=json
*.md        diff=markdown
